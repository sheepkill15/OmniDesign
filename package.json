{
  "name": "omnidesign",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "description": "AI-first desktop design tool",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm:dev:renderer\" \"pnpm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "test": "vitest run --environment jsdom --testTimeout=10000 --exclude=dist-electron/** --exclude=tests/e2e/**",
    "test:e2e": "pnpm build && playwright test -c playwright.e2e.config.ts",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "package:mac:arm64": "pnpm build && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "pnpm build && electron-builder --mac --x64 --publish never",
    "release:prepare": "node scripts/prepare-update-release.mjs",
    "vendor:alpine": "node scripts/vendor-alpine.mjs"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@tailwindcss/node": "4.3.3",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "react": "^19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "alpinejs": "^3.15.12",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
